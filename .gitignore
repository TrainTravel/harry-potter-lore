__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/
.env
data/*
!data/hp_lore.txt
!data/SOURCES.md
!data/trainset_*.py
# Character-lore pipeline artifacts (small, reproducible, worth tracking)
!data/character_lore.jsonl
!data/character_lore_tagged.jsonl
!data/tag_review*.md
# Virtualenvs
.venv/
venv/
list/
# Eval artifacts — generated per-run, overwritten by compare_dspy.sh;
# don't commit snapshots since they drift out of sync with runner code
evals/results.json
evals/results_dspy_*.json
# Compiled DSPy agent — tracked so Railway deploys include few-shot demos
# my_profile.agent/
# Scala build artifacts
scala-harness/project/target/
scala-harness/project/project/
scala-harness/target/
drafts/
# E2E (Playwright)
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/
e2e/dist/
# UI-critique runs produce timestamped folders of screenshots + critique.md.
# Re-runnable from scratch; the CI workflow uploads them as artifacts.
e2e/screenshots/
# macOS finder metadata
.DS_Store
# Claude Code harness state — scheduled-task locks, hook caches, etc.
# Private to a single developer's machine; never useful to commit.
.claude/
# Bloop / metals build-server protocol metadata (any subdir)
.bsp/
# Root sbt target dir (scala-harness/target/ already covered above).
# Generated bytecode + cache; rebuilt on every `sbt compile`.
/target/
# DSPy artifact backups created during ad-hoc migrations
# (e.g. `*.cot-bak` from the 2026-05-22 CoT-drop key migration).
# Once the migration is verified in prod they're disposable.
my_profile.agent/*.bak
my_profile.agent/*-bak
