{
  "name": "hp-lore-agent-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright E2E tests for the HP Lore Agent Lovable UI",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test tests/smoke.spec.ts",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "test:visual": "playwright test tests/visual.spec.ts",
    "report": "playwright show-report",
    "ui-critique:explore": "npx -y tsx scripts/explore.ts",
    "ui-critique:critique": "npx -y tsx scripts/critique.ts",
    "ui-critique": "npm run ui-critique:explore && npm run ui-critique:critique"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.49.0",
    "typescript": "^5.7.0"
  }
}
